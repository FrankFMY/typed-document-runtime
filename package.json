			"types": "./dist/application-data-contract.d.ts",
			"import": "./dist/application-data-contract.js"
		},
		"./application-data-query": {
			"types": "./dist/application-data-query.d.ts",
			"import": "./dist/application-data-query.js"
		},
		"./process-document": {
			"types": "./dist/process-document.d.ts",
			"import": "./dist/process-document.js"
