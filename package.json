	"scripts": {
		"lint": "oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives src tests scripts examples",
		"check": "tsc --project tsconfig.test.json",
		"test": "bun test src tests --max-concurrency 1",
		"build": "node scripts/build.mjs",
		"pack": "node scripts/pack.mjs",
		"verify:package": "node scripts/verify-package.mjs",
		"verify": "bun run lint && bun run check && bun test src tests --max-concurrency 1 && bun run build && bun run pack && bun run verify:package"
	},
	"dependencies": {
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"oxlint": "1.89.0",
		"playwright": "1.63.0",
		"typescript": "7.0.2",
