{
	"name": "@frankfmy/typed-document-runtime",
	"version": "0.1.1",
	"private": true,
	"description": "Typed document schemas, deterministic execution, process effects and interactive sandboxing.",
	"type": "module",
	"license": "Apache-2.0",
	"author": {
		"name": "Artem Prianishnikov",
		"email": "Pryanishnikovartem@gmail.com",
		"url": "https://frankfmy.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FrankFMY/typed-document-runtime.git"
	},
	"homepage": "https://github.com/FrankFMY/typed-document-runtime#readme",
	"bugs": {
		"url": "https://github.com/FrankFMY/typed-document-runtime/issues"
	},
	"engines": {
		"node": ">=24.20.0",
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2",
	"files": [
